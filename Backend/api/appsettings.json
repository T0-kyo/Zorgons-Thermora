{
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.AspNetCore": "Warning"
      }
    },
    "WriteTo": [
      {
        "Name": "Console"
      }
    ]
  },
  "DataSettings": {
    "BaseUrl": "https://huggingface.co/datasets/dabroot/thermora-fires/resolve/main",
    "TrendFile": "Vegetation_Fire_Trend_Analysis_2018_2024.parquet",
    "MemoryLimit": "1GB",
    "Threads": 4,
    "MaxConcurrentQueries": 2,
    "TempDirectory": "/tmp/duckdb_spill",
    "CacheMinutes": 30,
    "CacheEntries": 2000,
    "CatalogRefreshMinutes": 60,
    "CellLimit": 3000,
    "CellsPerCountry": 40,
    "ProgressBaselineStart": 2018,
    "ProgressWindowYears": 3,
    "PrecomputeCountryStats": true
  },
  "AllowedHosts": "*"
}
